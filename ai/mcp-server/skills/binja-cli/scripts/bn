# -- gui.py (needs mcp_server.screenshot_enabled) ----------------------------


def cmd_screenshot(conn: Connection, args) -> None:
    import base64

    result = conn.call_tool("capture_screenshot", {})
    content = (result.get("content") or [{}])[0]
    data = content.get("data")
    if not data:
        raise BnError("capture_screenshot returned no image data")
    out_path = Path(args.out) if args.out else Path.cwd() / "bn-screenshot.png"
    out_path.write_bytes(base64.b64decode(data))
    print(str(out_path))



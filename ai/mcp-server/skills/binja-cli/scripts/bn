# -- scripting.py execution tools (needs mcp_server.scripting_enabled) ------
#
# execute_script/load_script/run_snippet all share one server-side sync/async
# split (see scripting.py's execute_script docstring): sync holds the
# server's global tool-call lock until the script finishes -- simple, but
# blocks every other tool call for as long as the script runs, and (CLI-side)
# holds this process's HTTP socket open for the same span. async_run=True
# instead runs the script on its own thread immediately, returning a job_id
# to poll via get_script_status/cancel_script.
#
# The CLI exposes that as three modes rather than picking one:
#   (default) sync, with --timeout raising the connection's usual ~30s
#     socket timeout to something scripts can plausibly need.
#   --async   fire-and-forget: prints the job_id and exits immediately.
#   --wait    --async under the hood, but this process then polls
#     get_script_status locally every --interval seconds until it finishes
#     -- Ctrl-C detaches cleanly (the job keeps running server-side; it was
#     never tied to this process) instead of the blunt "kill the socket"
#     behavior sync mode gets from a plain Ctrl-C.


def _wait_for_job(conn: Connection, job_id: str, interval: float, timeout, fmt: str) -> None:
    deadline = time.monotonic() + timeout if timeout else None
    try:
        while True:
            result = conn.call_tool("get_script_status", {"job_id": job_id})
            status = (result.get("structuredContent") or {}).get("status")
            if status != "running":
                emit(result, fmt)
                return
            if deadline is not None and time.monotonic() >= deadline:
                raise BnError(
                    f"job {job_id} still running after {timeout:.0f}s -- "
                    f"reattach later with `bn job wait {job_id}`, or stop it with `bn job cancel {job_id}`"
                )
            time.sleep(interval)
    except KeyboardInterrupt:
        print(
            f"\nbn: detached -- job {job_id} keeps running server-side; "
            f"reattach with `bn job wait {job_id}`, or stop it with `bn job cancel {job_id}`",
            file=sys.stderr,
        )
        raise SystemExit(130)


def _run_script_like(conn: Connection, args, tool_name: str, arguments: dict) -> None:
    async_run = args.async_run or args.wait
    payload = dict(arguments, async_run=async_run)
    if not async_run:
        conn.set_timeout(args.timeout)
    try:
        result = conn.call_tool(tool_name, payload)
    except BnError as e:
        if not async_run and "timed out" in str(e):
            raise BnError(
                f"{e} -- script exceeded --timeout={args.timeout:.0f}s while running synchronously "
                "(sync mode holds the server's global lock the whole time, so other tool calls were "
                "blocked too, not just this one). Rerun with --async or --wait, or pass a larger --timeout."
            ) from e
        raise
    if not args.wait:
        emit(result, args.format)
        return
    job_id = (result.get("structuredContent") or {}).get("job_id")
    if not job_id:
        emit(result, args.format)  # shouldn't happen once async_run=True, but don't hide a surprise
        return
    print(f"job {job_id} running, waiting (Ctrl-C to detach without stopping it)...", file=sys.stderr)
    _wait_for_job(conn, job_id, args.interval, None, args.format)


def cmd_execute_script(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    _run_script_like(conn, args, "execute_script", {"script": args.script})


def cmd_load_script(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    resolved = str(Path(args.path).expanduser().resolve())
    _run_script_like(conn, args, "load_script", {"path": resolved})


def cmd_run_snippet(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    _run_script_like(conn, args, "run_snippet", {"name": args.name})


def cmd_job_status(conn: Connection, args) -> None:
    emit(conn.call_tool("get_script_status", {"job_id": args.job_id}), args.format)


def cmd_job_cancel(conn: Connection, args) -> None:
    emit(conn.call_tool("cancel_script", {"job_id": args.job_id}), args.format)


def cmd_job_wait(conn: Connection, args) -> None:
    _wait_for_job(conn, args.job_id, args.interval, args.timeout, args.format)


# -- administration.py analysis control (always registered) ----------------
#
# Unlike execute-script/load-script/run-snippet, there's no job_id here:
# BN's own update_analysis() is already asynchronous on BN's own worker
# threads once triggered, and analysis_status (BinaryView.analysis_progress)
# is a native poll target scoped to "the current binary", not to a
# particular call -- so --wait polls that directly instead of a job
# registry, and it works the same whether or not this process was the one
# that triggered the analysis.


def _wait_for_analysis(conn: Connection, interval: float, timeout, fmt: str) -> None:
    deadline = time.monotonic() + timeout if timeout else None
    try:
        while True:
            result = conn.call_tool("analysis_status", {})
            if (result.get("structuredContent") or {}).get("done"):
                emit(result, fmt)
                return
            if deadline is not None and time.monotonic() >= deadline:
                raise BnError(f"analysis still running after {timeout:.0f}s -- check again with `bn analysis-status`")
            time.sleep(interval)
    except KeyboardInterrupt:
        print(
            "\nbn: detached -- analysis keeps running server-side; check again with `bn analysis-status`",
            file=sys.stderr,
        )
        raise SystemExit(130)


def cmd_analyze(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    async_run = args.async_run or args.wait
    if not async_run:
        conn.set_timeout(args.timeout)
    try:
        result = conn.call_tool("reanalyze", {"wait": not async_run})
    except BnError as e:
        if not async_run and "timed out" in str(e):
            raise BnError(
                f"{e} -- analysis exceeded --timeout={args.timeout:.0f}s while running synchronously "
                "(sync mode holds the server's global lock the whole time, so other tool calls were "
                "blocked too, not just this one). Rerun with --async or --wait, or pass a larger --timeout."
            ) from e
        raise
    if not args.wait:
        emit(result, args.format)
        return
    print("analysis running, waiting (Ctrl-C to detach without stopping it)...", file=sys.stderr)
    _wait_for_analysis(conn, args.interval, None, args.format)


def cmd_analysis_status(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    if args.wait:
        _wait_for_analysis(conn, args.interval, args.timeout, args.format)
    else:
        emit(conn.call_tool("analysis_status", {}), args.format)


def cmd_health(args) -> int:
    print("instance:")
    data = _connection_file_data()
    pid = data.get("pid") if data else None
    if pid is None:
        print("  process: unknown -- no local connection file (remote server, or not started via `bn instance start`)")
    elif _pid_alive(pid):
        print(f"  process: running (pid {pid})")
    else:
        print(f"  process: not running -- stale pid {pid} in connection file (`bn instance close` to clean it up)")

    print("connection:")
    try:
        host, port, api_key = resolve_connection(args)
    except BnError as e:
        print(f"  FAIL -- {e}")
        return 1
    print(f"  target: http://{host}:{port}")
    print(f"  api key: {'set' if api_key else '(none -- auth disabled)'}")

    try:
        raw = http.client.HTTPConnection(host, port, timeout=5)
        raw.request("GET", "/health")
        resp = raw.getresponse()
        resp.read()
        reachable = resp.status == 200
        raw.close()
    except OSError as e:
        print(f"  reachable: FAIL -- {e}")
        return 1
    print(f"  reachable: {'OK' if reachable else f'FAIL (status {resp.status})'}")
    if not reachable:
        return 1

    conn = Connection(host, port, api_key)
    try:
        conn.handshake()
        print("  auth: OK")
    except BnError as e:
        print(f"  auth: FAIL -- {e}")
        return 1

    try:
        names = sorted(t["name"] for t in conn.list_tools())
    except BnError as e:
        print(f"  tools/list: FAIL -- {e}")
        return 1
    finally:
        conn.close()

    print(f"\ncommands enabled ({len(names)}):")
    for name in names:
        print(f"  {name}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--server", help="MCP server base host[:port] (default: local connection file)")
    common.add_argument("--api-key", help="API key (default: local connection file, or none if auth is disabled)")
    common.add_argument(
        "--binary", type=int, default=None, help="Binary index to target (default: current selection, else index 0)"
    )
    common.add_argument("--format", choices=["text", "json"], default="json", help="Output format (default: json)")

    # Same as `common` minus --binary, for tools that don't operate on any
    # particular binary (search_docs/read_logs/snippets touch BN's API docs,
    # log file, or snippets/ dir; capture_screenshot grabs the whole window).
    global_only = argparse.ArgumentParser(add_help=False)
    global_only.add_argument("--server", help="MCP server base host[:port] (default: local connection file)")
    global_only.add_argument("--api-key", help="API key (default: local connection file, or none if auth is disabled)")
    global_only.add_argument("--format", choices=["text", "json"], default="json", help="Output format (default: json)")

    # Shared by execute-script/load-script/run-snippet/analyze -- any
    # command with a sync-by-default/--async/--wait split. See the big
    # comment above _wait_for_job (script commands) or cmd_analyze
    # (analyze) for what each mode means for that specific command.
    long_running_opts = argparse.ArgumentParser(add_help=False)
    long_running_opts.add_argument(
        "--async", dest="async_run", action="store_true", help="Return immediately instead of blocking"
    )
    long_running_opts.add_argument(
        "--wait", action="store_true", help="Run async, then poll until it finishes (Ctrl-C detaches without stopping it)"
    )
    long_running_opts.add_argument(
        "--interval", type=float, default=_DEFAULT_POLL_INTERVAL, help=f"Seconds between polls with --wait (default: {_DEFAULT_POLL_INTERVAL:g})"
    )
    long_running_opts.add_argument(
        "--timeout",
        type=float,
        default=_DEFAULT_SCRIPT_TIMEOUT,
        help=f"Sync-mode socket timeout in seconds (default: {_DEFAULT_SCRIPT_TIMEOUT:.0f}); ignored with --async/--wait",
    )

    parser = argparse.ArgumentParser(prog="bn", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p_list = sub.add_parser(
        "list", parents=[common], help="List functions/symbols/types/sections/imports/exports/strings"
    )
    p_list.add_argument("kind", choices=_LIST_KINDS)
    p_list.add_argument("--filter", dest="name_regex", help="Substring or regex filter on name (value, for strings)")
    p_list.add_argument("--fields", help="Comma-separated field names to keep, e.g. name,addr")
    p_list.add_argument("--limit", type=int, default=None, help="Default: 100")
    p_list.add_argument("--offset", type=int, default=None, help="Default: 0")

    p_func = sub.add_parser("function", parents=[common], help="Get a function's metadata plus disassembly/IL")
    p_func.add_argument("name_or_addr", help="Function name, or address (hex or decimal)")
    p_func.add_argument("--il-level", dest="il_level", choices=_IL_LEVELS, default=None, help="Default: disassembly")

    p_xto = sub.add_parser("xrefs-to", parents=[common], help="Cross-references (code and data) to an address")
    p_xto.add_argument("addr")
    p_xto.add_argument("--limit", type=int, default=None, help="Default: 100")
    p_xto.add_argument("--offset", type=int, default=None, help="Default: 0")

    p_xfrom = sub.add_parser("xrefs-from", parents=[common], help="Cross-references (code and data) from an address")
    p_xfrom.add_argument("addr")
    p_xfrom.add_argument("--limit", type=int, default=None, help="Default: 100")
    p_xfrom.add_argument("--offset", type=int, default=None, help="Default: 0")

    p_type = sub.add_parser("type", parents=[common], help="Get a type's definition by name")
    p_type.add_argument("name")

    p_hex = sub.add_parser("hex", parents=[common], help="Dump raw bytes at an address (hex+ASCII view in --format text)")
    p_hex.add_argument("addr")
    p_hex.add_argument("length", type=int, help="Number of bytes to read")

    p_search = sub.add_parser(
        "search", parents=[common], help="Search function/symbol names and defined strings for a pattern"
    )
    p_search.add_argument("pattern")
    p_search.add_argument("--limit", type=int, default=None, help="Default: 50")

    p_select = sub.add_parser("select", parents=[common], help="Select which open binary subsequent calls target")
    p_select.add_argument("index", type=int, help="Index into program://binaries")

    p_load = sub.add_parser(
        "load-binary", parents=[common], help="Open a binary or .bndb file in the GUI (as a new tab) and select it"
    )
    p_load.add_argument("path", help="Path to the binary or .bndb file to open")

    sub.add_parser("health", parents=[common], help="Check connectivity, auth, and which commands are enabled")

    # -- instance lifecycle (local process control, no MCP server needed for
    # start/close/restart; save-all is a real tool call) --------------------
    p_instance = sub.add_parser("instance", help="Start, close, or manage the Binary Ninja application itself")
    instance_sub = p_instance.add_subparsers(dest="instance_command", required=True)

    p_inst_start = instance_sub.add_parser("start", help="Launch the Binary Ninja application")
    p_inst_start.add_argument(
        "--path", default=None, help="Path to the binaryninja executable (default: PATH, BN_PATH, or common install locations)"
    )

    p_inst_close = instance_sub.add_parser("close", help="Close the running Binary Ninja application")
    p_inst_close.add_argument(
        "--timeout", type=float, default=None, help=f"Seconds to wait after SIGTERM before SIGKILL (default: {_DEFAULT_CLOSE_TIMEOUT:.0f})"
    )

    p_inst_restart = instance_sub.add_parser(
        "restart", help="Close, then start, the Binary Ninja application -- e.g. to reload plugin changes"
    )
    p_inst_restart.add_argument(
        "--path", default=None, help="Path to the binaryninja executable (default: PATH, BN_PATH, or common install locations)"
    )
    p_inst_restart.add_argument(
        "--timeout", type=float, default=None, help=f"Seconds to wait after SIGTERM before SIGKILL (default: {_DEFAULT_CLOSE_TIMEOUT:.0f})"
    )

    instance_sub.add_parser("save-all", parents=[global_only], help="Save every open binary's analysis database")

    # -- writing.py (needs mcp_server.write_enabled, default on) ------------
    p_rf = sub.add_parser("rename-function", parents=[common], help="Rename a function")
    p_rf.add_argument("addr")
    p_rf.add_argument("name")

    p_rs = sub.add_parser("rename-symbol", parents=[common], help="Rename the symbol at an address")
    p_rs.add_argument("addr")
    p_rs.add_argument("name")

    p_c = sub.add_parser("comment", parents=[common], help="Set a comment at an address")
    p_c.add_argument("addr")
    p_c.add_argument("comment")

    p_fc = sub.add_parser("function-comment", parents=[common], help="Set a function-level comment")
    p_fc.add_argument("addr")
    p_fc.add_argument("comment")

    p_cs = sub.add_parser(
        "create-struct", parents=[common], help='Define a struct type, e.g. "struct node { int32_t id; };"'
    )
    p_cs.add_argument("c_struct")

    p_lh = sub.add_parser("load-header", parents=[common], help="Define every type declared in a C header file")
    p_lh.add_argument("path")

    p_st = sub.add_parser("set-type", parents=[common], help="Apply a data type to an address")
    p_st.add_argument("addr")
    p_st.add_argument("type_name")

    p_cf = sub.add_parser("create-function", parents=[common], help="Create a function at an address")
    p_cf.add_argument("addr")

    # -- patching.py (needs mcp_server.destructive_write_enabled, default off) --
    p_pa = sub.add_parser("patch-asm", parents=[common], help="Assemble and write bytes at an address")
    p_pa.add_argument("addr")
    p_pa.add_argument("assembly")

    p_eh = sub.add_parser("edit-hex", parents=[common], help="Overwrite bytes at an address with raw hex")
    p_eh.add_argument("addr")
    p_eh.add_argument("hex_bytes", metavar="hex", help='Raw hex, e.g. "9090"')

    # -- undo.py (needs mcp_server.undo_enabled, default off) ---------------
    p_undo = sub.add_parser(
        "undo", parents=[common], help="Revert BN's undo stack -- includes the user's own manual edits too"
    )
    p_undo.add_argument("--steps", type=int, default=None, help="Default: 1")

    # -- gui.py (needs mcp_server.screenshot_enabled, default off) ----------
    p_shot = sub.add_parser("screenshot", parents=[global_only], help="Capture the BN window to a PNG file")
    p_shot.add_argument("--out", default=None, help="Output path (default: ./bn-screenshot.png)")

    # -- scripting.py non-execution tools (needs mcp_server.scripting_enabled) --
    p_sd = sub.add_parser("search-docs", parents=[global_only], help="Search Binary Ninja's Python API")
    p_sd.add_argument("pattern")
    p_sd.add_argument("--limit", type=int, default=None, help="Default: 30")

    p_rl = sub.add_parser("read-logs", parents=[global_only], help="Read recent BN log lines (most recent first)")
    p_rl.add_argument("--limit", type=int, default=None, help="Default: 100")
    p_rl.add_argument("--offset", type=int, default=None, help="Default: 0")

    p_csn = sub.add_parser(
        "create-snippet", parents=[global_only], help="Save a script into BN's Snippet Manager by name"
    )
    p_csn.add_argument("name")
    p_csn.add_argument("script", help="Script text; for multi-line scripts use $(cat file.py) or shell quoting")

    sub.add_parser("list-snippets", parents=[global_only], help="List snippets in BN's Snippet Manager")

    p_es = sub.add_parser(
        "execute-script", parents=[common, long_running_opts], help="Execute a Python script inside the running BN process"
    )
    p_es.add_argument(
        "script",
        help="Script text; for multi-line scripts use $(cat file.py) or shell quoting. "
        "Namespace includes `bv` (current binary view) and `should_cancel()`.",
    )

    p_ls = sub.add_parser(
        "load-script", parents=[common, long_running_opts], help="Load and execute a Python script file (same semantics as execute-script)"
    )
    p_ls.add_argument("path")

    p_rsn = sub.add_parser(
        "run-snippet",
        parents=[common, long_running_opts],
        help="Run a snippet from BN's Snippet Manager by name (same semantics as execute-script)",
    )
    p_rsn.add_argument("name")

    # -- scripting.py job control (needs mcp_server.scripting_enabled) ------
    p_job = sub.add_parser("job", help="Check on, wait for, or cancel an async execute-script/load-script/run-snippet job")
    job_sub = p_job.add_subparsers(dest="job_command", required=True)

    p_job_status = job_sub.add_parser("status", parents=[global_only], help="Check an async job's status/result")
    p_job_status.add_argument("job_id")

    p_job_cancel = job_sub.add_parser("cancel", parents=[global_only], help="Request cancellation of a running async job (best-effort)")
    p_job_cancel.add_argument("job_id")

    p_job_wait = job_sub.add_parser("wait", parents=[global_only], help="Poll a running async job until it finishes")
    p_job_wait.add_argument("job_id")
    p_job_wait.add_argument("--interval", type=float, default=_DEFAULT_POLL_INTERVAL, help=f"Seconds between polls (default: {_DEFAULT_POLL_INTERVAL:g})")
    p_job_wait.add_argument("--timeout", type=float, default=None, help="Give up after this many seconds (default: wait forever)")

    # -- administration.py analysis control (always registered) -------------
    sub.add_parser(
        "analyze", parents=[common, long_running_opts], help="Trigger a full re-analysis of the current binary"
    )

    p_astat = sub.add_parser("analysis-status", parents=[common], help="Check the current binary's analysis progress")
    p_astat.add_argument("--wait", action="store_true", help="Poll until analysis finishes instead of a single check")
    p_astat.add_argument("--interval", type=float, default=_DEFAULT_POLL_INTERVAL, help=f"Seconds between polls with --wait (default: {_DEFAULT_POLL_INTERVAL:g})")
    p_astat.add_argument("--timeout", type=float, default=None, help="Give up after this many seconds (default: wait forever); ignored without --wait")

    return parser


_BINARY_SCOPED_COMMANDS = {
    "list": cmd_list,
    "function": cmd_function,
    "xrefs-to": cmd_xrefs_to,
    "xrefs-from": cmd_xrefs_from,
    "type": cmd_type,
    "hex": cmd_hex,
    "search": cmd_search,
    "select": cmd_select,
    "load-binary": cmd_load_binary,
    "rename-function": cmd_rename_function,
    "rename-symbol": cmd_rename_symbol,
    "comment": cmd_comment,
    "function-comment": cmd_function_comment,
    "create-struct": cmd_create_struct,
    "load-header": cmd_load_header,
    "set-type": cmd_set_type,
    "create-function": cmd_create_function,
    "patch-asm": cmd_patch_asm,
    "edit-hex": cmd_edit_hex,
    "undo": cmd_undo,
    "execute-script": cmd_execute_script,
    "load-script": cmd_load_script,
    "run-snippet": cmd_run_snippet,
    "analyze": cmd_analyze,
    "analysis-status": cmd_analysis_status,
}

_GLOBAL_COMMANDS = {
    "screenshot": cmd_screenshot,
    "search-docs": cmd_search_docs,
    "read-logs": cmd_read_logs,
    "create-snippet": cmd_create_snippet,
    "list-snippets": cmd_list_snippets,
}

_JOB_COMMANDS = {
    "status": cmd_job_status,
    "cancel": cmd_job_cancel,
    "wait": cmd_job_wait,
}


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)

    if args.command == "health":
        return cmd_health(args)

    if args.command == "instance" and args.instance_command in _INSTANCE_LOCAL_COMMANDS:
        try:
            _INSTANCE_LOCAL_COMMANDS[args.instance_command](args)
            return 0
        except BnError as e:
            print(f"bn: error: {e}", file=sys.stderr)
            return 1

    if args.command == "instance":  # only save-all left, a real tool call
        handler = cmd_save_all
    elif args.command == "job":
        handler = _JOB_COMMANDS[args.job_command]
    else:
        handler = _BINARY_SCOPED_COMMANDS.get(args.command) or _GLOBAL_COMMANDS.get(args.command)

    try:
        host, port, api_key = resolve_connection(args)
        conn = Connection(host, port, api_key)
        conn.handshake()
        try:
            handler(conn, args)
        finally:
            conn.close()
        return 0
    except BnError as e:
        print(f"bn: error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""bn -- CLI front end for a running Binary Ninja MCP server (binja-mcp).

A thin MCP client: every subcommand is exactly one call to the same
`/mcp` endpoint the MCP server exposes to any other client (see
ADR-0038 in the plugins repo) -- no separate API, no separate tool
implementation. stdlib-only by design (http.client, not urllib.request:
~10ms lighter cold start, and no ssl/email machinery a loopback call
never needs).

Server discovery, highest priority first:
  1. --server/--api-key flags
  2. BN_MCP_URL / BN_MCP_API_KEY environment variables
  3. the local connection file BN's plugin writes on server start
     (~/.cache/binja-mcp/server.json) -- zero-config for the common
     case: BN and this CLI on the same machine.

Run `bn <subcommand> --help` for a subcommand's own options. `bn health`
checks connectivity/auth and reports which commands the server currently
has enabled -- unlike --help, which is static and always shows the full
command set regardless of what the server's settings actually allow.
"""

import argparse
import http.client
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlsplit

_CONNECTION_FILE = Path.home() / ".cache" / "binja-mcp" / "server.json"
_PROTOCOL_VERSION = "2025-06-18"
_LIST_KINDS = ("functions", "symbols", "types", "sections", "imports", "exports", "strings")
_IL_LEVELS = ("disassembly", "llil", "mlil", "hlil", "llil_ssa", "mlil_ssa", "hlil_ssa")

# Common per-OS install locations, checked after PATH and before giving up --
# there's no single canonical install dir the way there is for most CLI
# tools, since BN ships as a GUI app extracted/installed wherever the user
# put it. `--path`/BN_PATH always wins over all of this (see
# find_bn_executable).
_DEFAULT_BN_PATHS = (
    Path.home() / "binaryninja" / "binaryninja",
    Path.home() / "tools" / "binaryninja" / "binaryninja",
    Path("/opt/binaryninja/binaryninja"),
    Path("/Applications/Binary Ninja.app/Contents/MacOS/binaryninja"),
    Path(os.environ.get("PROGRAMFILES", "")) / "Vector35" / "BinaryNinja" / "binaryninja.exe",
    Path(os.environ.get("LOCALAPPDATA", "")) / "Vector35" / "BinaryNinja" / "binaryninja.exe",
)
_DEFAULT_CLOSE_TIMEOUT = 15.0
_DEFAULT_SCRIPT_TIMEOUT = 300.0
_DEFAULT_POLL_INTERVAL = 1.0


class BnError(Exception):
    """A clean, user-facing failure -- printed without a traceback."""


def _connection_file_data():
    try:
        return json.loads(_CONNECTION_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def _pid_alive(pid: int) -> bool:
    """POSIX existence check (signal 0 sends nothing, just probes). A pid
    owned by another user still counts as alive -- PermissionError means it
    exists, just isn't ours to signal."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def find_bn_executable(explicit) -> Path:
    """Resolve the Binary Ninja executable for `instance start`/`restart`,
    highest priority first: --path, BN_PATH, PATH, then a handful of common
    per-OS install locations (see _DEFAULT_BN_PATHS) -- there's no one
    canonical install dir to assume, since BN is a GUI app extracted or
    installed wherever the user put it."""
    candidate = explicit or os.environ.get("BN_PATH")
    if candidate:
        p = Path(candidate).expanduser()
        if p.is_file():
            return p
        raise BnError(f"no Binary Ninja executable at {p}")
    which = shutil.which("binaryninja")
    if which:
        return Path(which)
    for p in _DEFAULT_BN_PATHS:
        if str(p) and p.is_file():
            return p
    raise BnError(
        "could not find the Binary Ninja executable -- pass --path, set BN_PATH, "
        "or put `binaryninja` on PATH"
    )


def resolve_connection(args):
    """--server/BN_MCP_URL wins outright (a deliberate, explicit target --
    its API key is looked up independently via --api-key/BN_MCP_API_KEY,
    never silently borrowed from the local connection file, which
    describes a *different*, same-machine server). Otherwise, fall back
    to the local connection file, where --api-key/BN_MCP_API_KEY may still
    override just the key (e.g. a manually rotated one)."""
    explicit = args.server or os.environ.get("BN_MCP_URL")
    if explicit:
        parsed = urlsplit(explicit if "//" in explicit else f"//{explicit}")
        host, port = parsed.hostname, parsed.port or 9090
        api_key = args.api_key or os.environ.get("BN_MCP_API_KEY", "")
        return host, port, api_key

    data = _connection_file_data()
    if not data:
        raise BnError(
            "no running BN MCP server found. Start it from Binary Ninja "
            "(Plugins -> MCP Server -> Start Server), or point at one explicitly "
            "with --server/--api-key or BN_MCP_URL/BN_MCP_API_KEY."
        )
    api_key = args.api_key or os.environ.get("BN_MCP_API_KEY") or data.get("api_key", "")
    return data["host"], data["port"], api_key


class Connection:
    """One MCP session per CLI process: initialize -> initialized -> as
    many tools/call | resources/read | tools/list requests as needed. Not
    reused across invocations -- pi (and every other harness this targets)
    runs each subcommand as a fresh process, so there's nothing to persist
    client-side; all real state (loaded binaries, selection, debugger
    sessions) lives server-side in BN itself."""

    def __init__(self, host, port, api_key):
        self.host, self.port, self.api_key = host, port, api_key
        self._conn = http.client.HTTPConnection(host, port, timeout=30)
        self._session_id = None
        self._next_id = 1

    def _headers(self):
        headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
        if self.api_key:
            headers["Authorization"] = f"Bearer {self.api_key}"
        if self._session_id:
            headers["mcp-session-id"] = self._session_id
        return headers

    @staticmethod
    def _parse_body(raw):
        # The transport frames even a single response as SSE
        # ("event: message\ndata: {...}\n\n") -- pull the JSON out of the
        # "data:" line. Falls back to plain JSON in case that ever changes.
        for line in raw.splitlines():
            if line.startswith("data:"):
                return json.loads(line[len("data:") :].strip())
        return json.loads(raw)

    def _call(self, method, params=None, notify=False):
        body = {"jsonrpc": "2.0", "method": method}
        if not notify:
            body["id"] = self._next_id
            self._next_id += 1
        if params is not None:
            body["params"] = params
        try:
            self._conn.request("POST", "/mcp", body=json.dumps(body), headers=self._headers())
            resp = self._conn.getresponse()
            raw = resp.read().decode("utf-8", errors="replace")
        except (OSError, http.client.HTTPException) as e:
            raise BnError(f"connection to {self.host}:{self.port} failed: {e}") from e
        sid = resp.getheader("mcp-session-id")
        if sid:
            self._session_id = sid
        if resp.status == 401:
            raise BnError("unauthorized -- wrong or missing API key")
        if resp.status >= 400:
            raise BnError(f"HTTP {resp.status}: {raw[:300]}")
        if notify:
            return None
        msg = self._parse_body(raw)
        if "error" in msg:
            raise BnError(msg["error"].get("message", str(msg["error"])))
        return msg["result"]

    def handshake(self):
        self._call(
            "initialize",
            {"protocolVersion": _PROTOCOL_VERSION, "capabilities": {}, "clientInfo": {"name": "bn", "version": "0.1"}},
        )
        self._call("notifications/initialized", notify=True)

    def call_tool(self, name, arguments):
        result = self._call("tools/call", {"name": name, "arguments": arguments})
        if result.get("isError"):
            raise BnError("".join(c.get("text", "") for c in result.get("content", [])) or "tool call failed")
        return result

    def read_resource(self, uri):
        result = self._call("resources/read", {"uri": uri})
        contents = result.get("contents", [])
        if contents and "text" in contents[0]:
            try:
                return json.loads(contents[0]["text"])
            except json.JSONDecodeError:
                return None
        return None

    def list_tools(self):
        return self._call("tools/list").get("tools", [])

    def set_timeout(self, seconds: float) -> None:
        """Override this connection's socket timeout -- used for synchronous
        execute-script/load-script/run-snippet calls, which may legitimately
        run far longer than the ~30s every other tool call needs. Updates
        both the live socket (already open from the initial handshake) and
        the connection's own default, in case it ever reconnects."""
        self._conn.timeout = seconds
        if self._conn.sock is not None:
            self._conn.sock.settimeout(seconds)

    def close(self):
        self._conn.close()


def _content_text(result) -> str:
    return "".join(c.get("text", "") for c in result.get("content", []))


def emit(result, fmt: str) -> None:
    """Print a tool result: `content` text by default (peeling a leading
    `#binary\\tindex\\tpath` marker line off to stderr, if present, so
    piping stdout through jq/grep stays clean), or `structuredContent` as
    real JSON with --format json."""
    if fmt == "json":
        structured = result.get("structuredContent")
        print(json.dumps(structured if structured is not None else {"text": _content_text(result)}, indent=2))
        return
    text = _content_text(result)
    first, _, rest = text.partition("\n")
    if first.startswith("#binary\t"):
        print(first[1:], file=sys.stderr)
        print(rest)
    else:
        print(text)


def ensure_binary_target(conn: Connection, args) -> None:
    """Resolve which binary this call should hit *before* making it. An
    explicit --binary always wins. Otherwise: if something is already
    explicitly selected (a prior `bn select`, server-side ambient state),
    leave it alone; if nothing is, default deterministically to index 0
    rather than depending on GUI focus -- see ADR-0038's "Binary
    targeting" section. Best-effort: any failure here is swallowed so the
    real command still runs and surfaces its own, clearer error (e.g. "no
    binary open") instead of failing inside this pre-flight step."""
    if args.binary is not None:
        try:
            conn.call_tool("select_binary", {"index": args.binary})
        except BnError:
            pass
        return
    try:
        selected = conn.read_resource("binary://selected")
    except BnError:
        return
    if selected and selected.get("explicitly_selected"):
        return
    try:
        conn.call_tool("select_binary", {"index": 0})
    except BnError:
        pass


def cmd_list(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    arguments = {"kind": args.kind}
    if args.name_regex:
        arguments["name_regex"] = args.name_regex
    if args.fields:
        arguments["fields"] = [f.strip() for f in args.fields.split(",") if f.strip()]
    if args.limit is not None:
        arguments["limit"] = args.limit
    if args.offset is not None:
        arguments["offset"] = args.offset
    emit(conn.call_tool("list", arguments), args.format)


def cmd_function(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    arguments = {"name_or_addr": args.name_or_addr}
    if args.il_level:
        arguments["il_level"] = args.il_level
    emit(conn.call_tool("get_function", arguments), args.format)


def cmd_xrefs_to(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    arguments = {"addr": args.addr}
    if args.limit is not None:
        arguments["limit"] = args.limit
    if args.offset is not None:
        arguments["offset"] = args.offset
    emit(conn.call_tool("get_xrefs_to", arguments), args.format)


def cmd_xrefs_from(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    arguments = {"addr": args.addr}
    if args.limit is not None:
        arguments["limit"] = args.limit
    if args.offset is not None:
        arguments["offset"] = args.offset
    emit(conn.call_tool("get_xrefs_from", arguments), args.format)


def cmd_type(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    emit(conn.call_tool("get_type", {"name": args.name}), args.format)


def _format_hexdump(base_addr: int, data: bytes, width: int = 16) -> str:
    """Classic `hexdump -C`-style offset/hex/ASCII view -- a client-side
    rendering convenience over get_data's plain hex string, same precedent
    as `screenshot` writing a PNG file: the tool call and its
    structuredContent are unchanged, only --format text's presentation is
    reshaped for a human at a terminal."""
    if not data:
        return "(no data)"
    lines = []
    for offset in range(0, len(data), width):
        chunk = data[offset : offset + width]
        hex_part = " ".join(f"{b:02x}" for b in chunk).ljust(width * 3 - 1)
        ascii_part = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
        lines.append(f"{base_addr + offset:#010x}  {hex_part}  {ascii_part}")
    return "\n".join(lines)


def cmd_hex(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    result = conn.call_tool("get_data", {"addr": args.addr, "size": args.length})
    if args.format == "json":
        emit(result, args.format)
        return
    text = _content_text(result)
    first, _, _ = text.partition("\n")
    if first.startswith("#binary\t"):
        print(first[1:], file=sys.stderr)
    structured = result.get("structuredContent") or {}
    data = bytes.fromhex(structured.get("hex", ""))
    base = int(structured.get("address", "0x0"), 16)
    print(_format_hexdump(base, data))


def cmd_search(conn: Connection, args) -> None:
    ensure_binary_target(conn, args)
    arguments = {"pattern": args.pattern}
    if args.limit is not None:
        arguments["limit"] = args.limit
    emit(conn.call_tool("search", arguments), args.format)


def cmd_select(conn: Connection, args) -> None:
    emit(conn.call_tool("select_binary", {"index": args.index}), args.format)


def cmd_load_binary(conn: Connection, args) -> None:
    # Resolve relative to *this process's* cwd before sending: the server
    # gets a path over HTTP and has no idea what directory `bn` was
    # invoked from, so a relative path would otherwise resolve against
    # BN's own (likely unrelated) working directory instead.
    resolved = str(Path(args.path).expanduser().resolve())
    emit(conn.call_tool("load_binary", {"path": resolved}), args.format)


def cmd_save_all(conn: Connection, args) -> None:
    emit(conn.call_tool("save_all", {}), args.format)


# -- instance lifecycle (no MCP server required -- local process control) --
#
# Deliberately outside the MCP client path: `start` has to work *before* any
# server exists, and `close` is a signal sent to a local pid, not a tool
# call. Both read/write the same connection file the running server itself
# writes on start/stop (see connection_file.py) as the source of truth for
# "is an instance running, and which pid is it" -- inherently local-machine
# only, same as that file's own zero-config design.


def cmd_instance_start(args) -> None:
    exe = find_bn_executable(args.path)
    try:
        proc = subprocess.Popen(
            [str(exe)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as e:
        raise BnError(f"failed to launch {exe}: {e}") from e
    time.sleep(1.0)
    if proc.poll() is not None:
        raise BnError(f"{exe} exited immediately (code {proc.returncode}) -- check BN's own logs")
    print(f"started Binary Ninja (pid {proc.pid}) from {exe}")


def cmd_instance_close(args) -> None:
    data = _connection_file_data()
    pid = data.get("pid") if data else None
    if pid is None:
        raise BnError("no running instance found (no local connection file)")
    if not _pid_alive(pid):
        print(f"instance (pid {pid}) is already not running")
        _CONNECTION_FILE.unlink(missing_ok=True)
        return

    timeout = args.timeout if args.timeout is not None else _DEFAULT_CLOSE_TIMEOUT
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not _pid_alive(pid):
            print(f"closed Binary Ninja (pid {pid})")
            _CONNECTION_FILE.unlink(missing_ok=True)
            return
        time.sleep(0.5)

    os.kill(pid, signal.SIGKILL)
    time.sleep(0.5)
    if _pid_alive(pid):
        raise BnError(f"Binary Ninja (pid {pid}) is still running after SIGKILL")
    print(f"Binary Ninja (pid {pid}) didn't exit within {timeout:.0f}s of SIGTERM -- force-killed")
    _CONNECTION_FILE.unlink(missing_ok=True)


def cmd_instance_restart(args) -> None:
    try:
        cmd_instance_close(args)
    except BnError as e:
        print(f"(nothing to close: {e})")
    cmd_instance_start(args)


_INSTANCE_LOCAL_COMMANDS = {
    "start": cmd_instance_start,
    "close": cmd_instance_close,
    "restart": cmd_instance_restart,
}


